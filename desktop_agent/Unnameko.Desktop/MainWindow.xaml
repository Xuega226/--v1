                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="打开草稿区" Width="82" Height="27" Margin="0,0,7,0"
                                            Click="OpenAutonomyDirectoryButton_Click" />
                                    <Button Content="刷新" Width="58" Height="27" Click="RefreshAutonomyButton_Click" />
                                </StackPanel>
                                <TextBlock x:Name="AutonomyFeedbackText" Margin="0,6,0,0" FontSize="10"
                                           TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="感知">
                    <Border CornerRadius="16" Background="#AFFFFFFF" BorderBrush="#2078A98C" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="13">
                            <TextBlock Text="感知权限策略" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="CurrentTargetText" Text="当前目标：尚未选择外部窗口"
                                       Margin="0,4,0,7" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="模式" VerticalAlignment="Center" FontSize="11" />
                                <ComboBox x:Name="PerceptionModeBox" Width="150" Margin="8,0,0,0" SelectedIndex="1">
                                    <ComboBoxItem Content="隐私模式" Tag="privacy" />
                                    <ComboBoxItem Content="陪伴模式（推荐）" Tag="companion" />
                                    <ComboBoxItem Content="Agent 模式" Tag="agent" />
                                </ComboBox>
                                <Button Content="保存" Width="56" Height="27" Margin="7,0,0,0"
                                        Click="SavePerceptionPolicyButton_Click" />
                            </StackPanel>
                            <TextBlock Text="信任的应用（进程名，逗号分隔）" Margin="0,7,0,3" FontSize="10"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <TextBox x:Name="TrustedAppsBox" MinHeight="29" Padding="6,4" TextWrapping="Wrap" />
                            <TextBlock Text="始终禁止感知的应用" Margin="0,6,0,3" FontSize="10"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <TextBox x:Name="BlockedAppsBox" MinHeight="29" Padding="6,4" TextWrapping="Wrap" />
                            <CheckBox x:Name="SendPerceptionToModelBox" Margin="0,7,0,0" IsChecked="True"
                                      Content="允许把筛选后的感知摘要发送给 DeepSeek 对话模型" />
                            <TextBlock Text="窗口标题、UIA、变化检测和 OCR 在本机读取；勾选上项后，只有整理后的文字摘要会随聊天发送给 DeepSeek。截图原图不会发送给 DeepSeek。"
                                       Margin="0,4,0,8" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <Border Height="1" Background="#2678A98C" Margin="0,1,0,10" />

                            <TextBlock Text="一次性桌面上下文" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="隐私模式需要先勾选；陪伴和 Agent 模式下，点击读取按钮本身就是一次授权。禁止名单始终优先。"
                                       Margin="0,4,0,11" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <CheckBox x:Name="ClipboardConsentBox" Content="允许读取一次剪贴板文本" />
                            <Button Content="读取剪贴板并预览" Height="29" Margin="0,5,0,10"
                                    Click="CaptureClipboardButton_Click" />
                            <CheckBox x:Name="WindowConsentBox" Content="允许读取一次最近活动窗口标题" />
                            <Button Content="读取窗口标题并预览" Height="29" Margin="0,5,0,10"
                                    Click="CaptureWindowButton_Click" />
                            <CheckBox x:Name="StructureConsentBox" Content="允许读取一次最近活动窗口的控件结构" />
                            <Button Content="读取控件结构（UIA）" Height="29" Margin="0,5,0,10"
                                    Click="CaptureStructureButton_Click" />
                            <CheckBox x:Name="ScreenshotConsentBox" Content="允许截取一次最近活动窗口" />
                            <Button Content="截取并识别窗口内容" Height="29" Margin="0,5,0,10"
                                    Click="CaptureScreenshotButton_Click" />

                            <Border Height="1" Background="#2678A98C" Margin="0,2,0,10" />
                            <TextBlock Text="限时陪伴观察" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="只锁定启动前最后使用的一个窗口；每 2 秒做一次本地变化采样，未变化时不会调用模型。关闭窗口、到时或手动停止都会立即结束。"
                                       Margin="0,4,0,8" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="持续时间" VerticalAlignment="Center" FontSize="11" />
                                <ComboBox x:Name="ObservationDurationBox" Width="88" Margin="8,0,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="5 分钟" Tag="5" />
                                    <ComboBoxItem Content="15 分钟" Tag="15" />
                                    <ComboBoxItem Content="30 分钟" Tag="30" />
                                    <ComboBoxItem Content="60 分钟" Tag="60" />
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="ObservationConsentBox" Margin="0,7,0,0"
                                      Content="允许在这段时间读取窗口标题、控件树与变化样本" />
                            <CheckBox x:Name="ObservationVisionConsentBox" Margin="0,5,0,0"
                                      Content="明显变化时允许截图识别（最多 5 次，间隔至少 30 秒）" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <Button x:Name="StartObservationButton" Content="开始观察" Width="92" Height="29"
                                        Click="StartObservationButton_Click" />
                                <Button x:Name="StopObservationButton" Content="停止" Width="64" Height="29"
                                        Margin="7,0,0,0" IsEnabled="False" Click="StopObservationButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="ObservationStatusText" Text="未观察任何窗口" Margin="0,5,0,9"
                                       FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" />

                            <TextBlock Text="待发送的上下文" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                            <TextBox x:Name="PerceptionPreviewBox" Height="120" Margin="0,4,0,0" Padding="7,5"
                                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="可以在输入框写具体问题；也可以直接点发送，让未名子主动概括预览内容。"
                                       Margin="0,4,0,0" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubtleBrush}" />
                            <Button Content="清除上下文" Height="27" Margin="0,7,0,0" Click="ClearPerceptionButton_Click" />
                            <TextBlock x:Name="PerceptionFeedbackText" Margin="0,6,0,0" FontSize="10"
                                       TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="4" Margin="18,0,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" MinHeight="42" MaxHeight="92" Padding="12,10"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         BorderBrush="#4878A98C" BorderThickness="1" Background="#F8FFFFFF"
                         Foreground="{StaticResource InkBrush}" KeyDown="InputBox_KeyDown" />
                <Button Grid.Column="1" Content="发送" Margin="10,0,0,0" Click="SendButton_Click"
                        Background="{StaticResource LeafBrush}" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>

    <Border x:Name="SettingsScrim" Panel.ZIndex="70" Margin="14" CornerRadius="26"
            Background="#240F1A13" Visibility="Collapsed"
            MouseLeftButtonDown="SettingsScrim_MouseLeftButtonDown" />
    <Border x:Name="SettingsDrawer" Panel.ZIndex="80" Width="350" Margin="0,62,18,74"
            HorizontalAlignment="Right" VerticalAlignment="Stretch" CornerRadius="20"
            Background="#FCFFFE" BorderBrush="#7078A98C" BorderThickness="1"
            Visibility="Collapsed">
        <Border.Effect>
            <DropShadowEffect Color="#50142319" BlurRadius="18" ShadowDepth="4" Opacity="0.4" />
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <Button Content="×" Width="28" Height="28" DockPanel.Dock="Right"
                        Click="CloseSettingsDrawerButton_Click" />
                <StackPanel>
                    <TextBlock Text="设置与权限" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="日常面板只保留常用入口；详细权限仍可随时检查。"
                               Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="11" CornerRadius="12" Background="#EFF7F1"
                            BorderBrush="#4078A98C" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="主动陪伴" FontWeight="SemiBold" Foreground="#426C52" />
                            <TextBlock x:Name="SettingsProactiveSummaryText" Margin="0,4,0,7"
                                       FontSize="10" TextWrapping="Wrap" Foreground="#66806E"
                                       Text="正在读取主动陪伴状态…" />
                            <WrapPanel>
                                <Button Content="调整节奏" Width="76" Height="26" Margin="0,0,6,0"
                                        Click="OpenProactiveSettingsButton_Click" />
                                <Button Content="今天安静" Width="70" Height="26"
                                        Click="QuietTodayButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Padding="11" CornerRadius="12" Background="#F6F9F6" Margin="0,9,0,0"
                            BorderBrush="#3078A98C" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="自主权限" FontWeight="SemiBold" Foreground="#426C52" />
                            <TextBlock x:Name="SettingsAutonomySummaryText" Margin="0,4,0,7"
                                       FontSize="10" TextWrapping="Wrap" Foreground="#66806E"
                                       Text="正在读取自主权限…" />
                            <Button Content="管理项目助手、研究权限和草稿" Height="27"
                                    Click="OpenAutonomySettingsButton_Click" />
                        </StackPanel>
                    </Border>
                    <Border Padding="11" CornerRadius="12" Background="#F6F9F6" Margin="0,9,0,0"
                            BorderBrush="#3078A98C" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="桌面感知" FontWeight="SemiBold" Foreground="#426C52" />
                            <TextBlock x:Name="SettingsPerceptionSummaryText" Margin="0,4,0,7"
                                       FontSize="10" TextWrapping="Wrap" Foreground="#66806E"
                                       Text="陪伴模式 · 只发送整理后的文字摘要" />
                            <Button Content="添加上下文或管理感知权限" Height="27"
                                    Click="OpenPerceptionDetailButton_Click" />
                        </StackPanel>
                    </Border>
                    <Border Padding="11" CornerRadius="12" Background="#FFF9EE" Margin="0,9,0,0"
                            BorderBrush="#40C49A50" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="高级诊断" FontWeight="SemiBold" Foreground="#765F38" />
                            <TextBlock Text="能力卡、仲裁成本、信任、生活日志、熔断和审计记录仍完整保留。"
                                       Margin="0,4,0,7" FontSize="10" TextWrapping="Wrap" Foreground="#806F52" />
                            <Button Content="查看自主性高级详情" Height="27"
                                    Click="OpenAutonomyDetailButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>

    <Grid x:Name="PetModeRoot" Visibility="Collapsed" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="112" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border x:Name="PetBubbleBorder" Margin="9,2,9,9" Padding="13,10" CornerRadius="18"
                Background="#F8FFFC" BorderBrush="#6078A98C" BorderThickness="1"
                VerticalAlignment="Bottom" Visibility="Hidden" Opacity="0"
                RenderTransformOrigin="0.5,1"
                MouseEnter="PetBubbleBorder_MouseEnter" MouseLeave="PetBubbleBorder_MouseLeave">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetBubbleScale" ScaleX="0.96" ScaleY="0.96" />
                    <TranslateTransform x:Name="PetBubbleLift" Y="7" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#3D1F382A" BlurRadius="13" ShadowDepth="3" Opacity="0.35" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="BubbleKindText" Text="未名子" FontSize="9" FontWeight="SemiBold"
                           Foreground="#668E76" HorizontalAlignment="Left" />
                <TextBlock x:Name="PetBubbleText" Grid.Row="1" Text="主人，我在这里喵。" TextWrapping="Wrap"
                           TextAlignment="Center" MaxHeight="55" FontSize="13" LineHeight="18"
                           Foreground="#35423A" Margin="0,2,0,0" />
                <StackPanel x:Name="BubbleHistoryPanel" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,3,0,-4" Visibility="Collapsed">
                    <Button Content="‹" Width="24" Height="18" MinHeight="18" Padding="0" BorderThickness="0"
                            Background="Transparent" Click="BubblePreviousButton_Click" />
                    <TextBlock x:Name="BubbleHistoryPositionText" Text="1/1" Margin="6,0"
                               VerticalAlignment="Center" FontSize="9" Foreground="#77827C" />
                    <Button Content="›" Width="24" Height="18" MinHeight="18" Padding="0" BorderThickness="0"
                            Background="Transparent" Click="BubbleNextButton_Click" />
                </StackPanel>
                <StackPanel x:Name="ProactiveBubbleActions" Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,3,0,-4" Visibility="Collapsed">
                    <Button x:Name="ProactiveReplyButton" Content="回应" Width="64" Height="20" MinHeight="20" Padding="0"
                            Margin="0,0,5,0" Click="ProactiveReplyButton_Click" />
                    <Button Content="稍后" Width="42" Height="20" MinHeight="20" Padding="0"
                            Margin="0,0,5,0" Click="ProactiveLaterButton_Click" />
                    <Button Content="忽略" Width="42" Height="20" MinHeight="20" Padding="0"
                            Click="ProactiveDismissButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Ellipse x:Name="PetAura" Width="246" Height="246" Fill="#2078A98C"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse x:Name="PetShadow" Width="152" Height="20" Fill="#241E2C24"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,196,0,0"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="PetShadowScale" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="PetBusyRing" Width="238" Height="238" Stroke="#9DBB78" StrokeThickness="4"
                     StrokeDashArray="2,5" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.RenderTransform><RotateTransform x:Name="PetBusyRingRotation" /></Ellipse.RenderTransform>
            </Ellipse>
            <Border x:Name="PetAvatarBorder" Width="224" Height="224" CornerRadius="112"
                    Background="#EFF7F1" BorderBrush="#7078A98C" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="PetAvatar_MouseLeftButtonDown"
                    MouseEnter="PetAvatar_MouseEnter" MouseLeave="PetAvatar_MouseLeave"
                    ToolTip="拖动未名子；双击打开完整面板">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetAvatarScale" ScaleX="1" ScaleY="1" />
                        <ScaleTransform x:Name="PetAvatarHoverScale" ScaleX="1" ScaleY="1" />
                        <ScaleTransform x:Name="PetAvatarDragScale" ScaleX="1" ScaleY="1" />
                        <ScaleTransform x:Name="PetAvatarReactionScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="PetAvatarDragTilt" Angle="0" />
                        <RotateTransform x:Name="PetAvatarTilt" Angle="0" />
                        <TranslateTransform x:Name="PetAvatarFloat" Y="0" />
                        <TranslateTransform x:Name="PetAvatarReactionOffset" X="0" Y="0" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Clip><EllipseGeometry Center="112,112" RadiusX="112" RadiusY="112" /></Border.Clip>
                <Image x:Name="PetAvatarImage" Source="Assets/unnameko.png" Stretch="UniformToFill" />
            </Border>

            <Border x:Name="PetEmoteBadge" Panel.ZIndex="12" Background="#F5FFFFFF"
                    BorderBrush="#45D7829B" BorderThickness="1" CornerRadius="18" Padding="7,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,20,0,0"
                    Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="PetEmoteScale" ScaleX="0.7" ScaleY="0.7" /></Border.RenderTransform>
                <TextBlock x:Name="PetEmote" Text="♡" FontSize="29" FontWeight="Bold" Foreground="#D7829B" />
            </Border>

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3"
                    Padding="11,5" CornerRadius="13" Background="#EFFFFFFF"
                    BorderBrush="#4878A98C" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="PetConnectionDot" Width="8" Height="8" Fill="#D5A6A6"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="PetStateText" Text="正在连接…" Margin="7,0,0,0"
                               FontSize="11" Foreground="#536158" />
                </StackPanel>
            </Border>

            <Button Content="×" Width="30" Height="30" Padding="0" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,4,4,0" Click="HideButton_Click"
                    Background="#EFFFFFFF" BorderBrush="#3078A98C" />
        </Grid>

        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="5" CornerRadius="18" Background="#EFFFFFFF"
                BorderBrush="#3478A98C" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Button Content="摸摸头" Width="70" Height="30" Margin="0,0,5,0"
                        Click="PetHeadpatButton_Click" />
                <Button Content="聊聊" Width="58" Height="30" Margin="0,0,5,0"
                        Click="PetChatButton_Click" />
                <Button Content="面板" Width="58" Height="30" Click="TogglePetModeButton_Click"
                        Background="#78A98C" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>

    <Border x:Name="SnapHintBadge" Panel.ZIndex="115" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,5,0,0" Padding="11,5" CornerRadius="13" Background="#F4FFFC"
            BorderBrush="#8078A98C" BorderThickness="1" Visibility="Collapsed" Opacity="0"
            IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="SnapHintScale" ScaleX="0.92" ScaleY="0.92" /></Border.RenderTransform>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="◈" FontSize="11" Foreground="#6A9A7B" VerticalAlignment="Center" />
            <TextBlock x:Name="SnapHintText" Text="松手吸附到右侧" Margin="6,0,0,0"
                       FontSize="10" FontWeight="SemiBold" Foreground="#496354" />
        </StackPanel>
    </Border>

    <Border x:Name="ToastBorder" Panel.ZIndex="100" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="24,22,24,0" Padding="13,8" CornerRadius="13" Background="#F3FFF9"
            BorderBrush="#6878A98C" BorderThickness="1" Visibility="Collapsed" Opacity="0">
        <Border.Effect>
            <DropShadowEffect Color="#4518271F" BlurRadius="12" ShadowDepth="3" Opacity="0.35" />
        </Border.Effect>
        <TextBlock x:Name="ToastText" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="350"
                   FontSize="12" Foreground="#3D4B42" />
    </Border>
    </Grid>

</Window>
