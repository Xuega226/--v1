                                                                 Value="{Binding ProgressPercent}" Maximum="100" Height="4"
                                                                 Margin="0,7,0,0" Foreground="#78A98C" Background="#DCE9E0"
                                                                 BorderThickness="0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                                               Text="{Binding ProgressText}" HorizontalAlignment="Right"
                                                               Margin="0,4,0,0" FontSize="9" Foreground="#718078" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
