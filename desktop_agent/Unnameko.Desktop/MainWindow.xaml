<Window x:Class="Unnameko.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="未名子" Width="460" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#627168" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Background" Value="#EEF5F0" />
            <Setter Property="BorderBrush" Value="#4078A98C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#425148" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#E1EFE6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#66736B" />
            <Setter Property="Padding" Value="13,6" />
            <Setter Property="Margin" Value="0,0,3,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabChrome" Background="Transparent" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#E4F0E8" />
                                <Setter Property="Foreground" Value="#426C52" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#EEF5F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowRoot">
    <Border x:Name="FullPanelRoot" Margin="14" CornerRadius="26" Background="#F5FFFAFA"
            BorderBrush="#4078A98C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#650E1B14" BlurRadius="22" ShadowDepth="6" Opacity="0.42" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="164" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#D5A6A6" />
                    <TextBlock Text="未名子" Margin="9,0,0,0" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderStateText" Text="连接中" Margin="8,1,0,0" FontSize="10"
                               Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                    <Border x:Name="PerceptionIndicator" Margin="8,0,0,0" Padding="7,2" CornerRadius="8"
                            Background="#EAF4EC" BorderBrush="#6078A98C" BorderThickness="1"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="PerceptionIndicatorText" Text="● 观察中" FontSize="9"
                                   Foreground="#4D785B" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,12,0">
                    <Button x:Name="SettingsNavButton" Content="⚙" ToolTip="设置与权限" Click="SettingsNavButton_Click"
                            Style="{StaticResource WindowButton}" FontSize="14" />
                    <Button Content="◫" ToolTip="切换为桌宠模式" Click="TogglePetModeButton_Click"
                            Style="{StaticResource WindowButton}" FontSize="15" />
                    <Button Content="—" Click="HideButton_Click" Style="{StaticResource WindowButton}" />
                    <Button Content="×" Click="HideButton_Click" Style="{StaticResource WindowButton}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="142" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="142" Height="148" VerticalAlignment="Center">
                    <Ellipse x:Name="AvatarGlow" Width="142" Height="142" Fill="#2278A98C" />
                    <Ellipse x:Name="ActivityRing" Width="140" Height="140" Stroke="#9DBB78" StrokeThickness="3"
                             StrokeDashArray="2,5" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform x:Name="ActivityRingRotation" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Border x:Name="AvatarBorder" Width="132" Height="132" CornerRadius="66" BorderBrush="#5078A98C"
                            BorderThickness="2" Background="#EAF6EE" VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="AvatarScale" ScaleX="1" ScaleY="1" />
                                <ScaleTransform x:Name="AvatarDragScale" ScaleX="1" ScaleY="1" />
                                <ScaleTransform x:Name="AvatarReactionScale" ScaleX="1" ScaleY="1" />
                                <RotateTransform x:Name="AvatarDragTilt" Angle="0" />
                                <RotateTransform x:Name="AvatarTilt" Angle="0" />
                                <TranslateTransform x:Name="AvatarFloat" Y="0" />
                                <TranslateTransform x:Name="AvatarReactionOffset" X="0" Y="0" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Clip>
                            <EllipseGeometry Center="66,66" RadiusX="66" RadiusY="66" />
                        </Border.Clip>
                        <Image x:Name="AvatarImage" Source="Assets/unnameko.png" Stretch="UniformToFill" />
                    </Border>
                    <Border x:Name="AvatarEmoteBadge" Panel.ZIndex="8" Background="#F5FFFFFF"
                            BorderBrush="#40D7829B" BorderThickness="1" CornerRadius="14" Padding="6,0"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"
                            Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="AvatarEmoteScale" ScaleX="0.7" ScaleY="0.7" /></Border.RenderTransform>
                        <TextBlock x:Name="AvatarEmote" Text="♡" FontSize="22" FontWeight="Bold" Foreground="#D7829B" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="18,24,0,0">
                    <TextBlock Text="在电脑里陪着主人" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock x:Name="ActivityText" Text="正在连接生活状态…" Margin="0,10,0,0"
                               Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                    <Border x:Name="MoodPill" Margin="0,13,0,0" Padding="10,5" CornerRadius="11" Background="#1878A98C"
                            HorizontalAlignment="Left">
                        <TextBlock x:Name="MoodText" Text="心情：等待中" Foreground="#54675B" FontSize="12" />
                    </Border>
                    <TextBlock x:Name="StateDetailText" Text="核心连接中" Margin="0,8,0,0"
                               FontSize="10" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                    <ProgressBar x:Name="EnergyBar" Height="4" Margin="0,5,18,0" Minimum="0" Maximum="1"
                                 Value="0.5" Foreground="#78A98C" Background="#DCE9E0" BorderThickness="0" />
                    <ProgressBar x:Name="BusyIndicator" Height="3" Margin="0,6,18,0" IsIndeterminate="True"
                                 Foreground="#9DBB78" Background="Transparent" BorderThickness="0"
                                 Visibility="Collapsed" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="18,0,18,9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1" />
                    <RowDefinition Height="36" />
                </Grid.RowDefinitions>
                <Border Background="#2778A98C" />
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CompanionNavButton" Content="陪伴" Width="66" Height="28"
                            Margin="0,0,6,0" Click="CompanionNavButton_Click" />
                    <Button x:Name="WorkNavButton" Grid.Column="1" Content="工作" Width="66" Height="28"
                            Margin="0,0,6,0" Click="WorkNavButton_Click" />
                    <Button x:Name="MemoryNavButton" Grid.Column="2" Content="记忆" Width="66" Height="28"
                            Click="MemoryNavButton_Click" />
                    <TextBlock x:Name="NavigationContextText" Grid.Column="3" Margin="9,0,0,0"
                               VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
                </Grid>
            </Grid>

            <TabControl x:Name="MainTabs" Grid.Row="3" Margin="18,0,18,12" Background="Transparent"
                        BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectedContentStringFormat}" />
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="对话">
                    <Border CornerRadius="16" Background="#AFFFFFFF" BorderBrush="#2078A98C" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="10,7" BorderBrush="#2078A98C" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button Content="添加桌面上下文" Width="104" Height="25"
                                            DockPanel.Dock="Right" Click="OpenPerceptionDetailButton_Click" />
                                    <TextBlock Text="和未名子说说话" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{StaticResource SubtleBrush}" />
                                </DockPanel>
                            </Border>
                            <ScrollViewer x:Name="ChatScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
                                <TextBlock x:Name="ChatText" TextWrapping="Wrap" Foreground="{StaticResource InkBrush}"
                                           FontSize="14" LineHeight="23">
                                    <Run Text="未名子&#x0a;" FontWeight="SemiBold" Foreground="#668E76" />
                                    <Run Text="主人，我已经醒着啦。窗口重开也不会让我忘记刚才发生的事，喵。" />
                                </TextBlock>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="任务">
                    <Border CornerRadius="16" Background="#AFFFFFFF" BorderBrush="#2078A98C" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="13">
                            <StackPanel>
                                <TextBlock Text="工作" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="目标、计划、进行中的任务、项目下一步和她准备的草稿都从这里进入。"
                                            Margin="0,4,0,10" FontSize="11" TextWrapping="Wrap"
                                            Foreground="{StaticResource SubtleBrush}" />
                                <Border Padding="10" CornerRadius="12" Background="#EFF7F1"
                                        BorderBrush="#5078A98C" BorderThickness="1" Margin="0,0,0,11">
                                    <StackPanel>
                                        <TextBlock x:Name="WorkOverviewText" Text="正在整理当前工作…"
                                                   FontWeight="SemiBold" Foreground="#426C52" TextWrapping="Wrap" />
                                        <TextBlock x:Name="WorkAttentionText" Margin="0,4,0,7" FontSize="10"
                                                   Foreground="#66806E" TextWrapping="Wrap"
                                                   Text="没有需要主人立即处理的事项。" />
                                        <WrapPanel>
                                            <Button Content="项目与下一步" Width="94" Height="26" Margin="0,0,6,0"
                                                    Click="OpenProjectsDetailButton_Click" />
                                            <Button Content="自主草稿与依据" Width="108" Height="26"
                                                    Click="OpenAutonomyDetailButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="交给她一个目标" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource InkBrush}" Margin="0,0,0,6" />
                                <TextBox x:Name="GoalTextBox" Margin="0,0,0,8" Padding="8,6" Height="68"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <Button x:Name="CreateGoalPlanButton" Content="生成计划预览" Height="32"
                                        Click="CreateGoalPlanButton_Click"
                                        Background="{StaticResource LeafBrush}" Foreground="White" BorderThickness="0" />
                                <TextBlock x:Name="TaskFeedbackText" Margin="0,7,0,0" FontSize="11"
                                           Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />

                                <Border x:Name="PlanPreviewCard" Visibility="Collapsed" Margin="0,12,0,0"
                                        Padding="11" CornerRadius="12" Background="#EFF7F1"
                                        BorderBrush="#78A98C" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="计划预览" FontWeight="SemiBold" Foreground="#426C52" />
                                        <TextBlock x:Name="PlanTitleText" Margin="0,5,0,0" FontSize="13"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock x:Name="PlanStepsText" Margin="0,6,0,8" FontSize="11"
                                                   LineHeight="18" TextWrapping="Wrap" Foreground="#52685A" />
                                        <TextBlock x:Name="PlanMetricsText" Margin="0,0,0,7" FontSize="10"
                                                   TextWrapping="Wrap" Foreground="#66806E" />
                                        <Expander x:Name="PlanDocumentEditExpander" Header="编辑第一份输出文档" Margin="0,0,0,8">
                                            <StackPanel Margin="0,7,0,0">
                                                <TextBox x:Name="PlanEditTitleBox" Margin="0,0,0,5" Padding="7,4" />
                                                <TextBox x:Name="PlanEditPathBox" Margin="0,0,0,5" Padding="7,4" />
                                                <TextBox x:Name="PlanEditContentBox" Height="90" Padding="7,5"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                                <Button Content="保存草案修改" Height="27" Margin="0,6,0,0"
                                                        Click="SavePlanEditButton_Click" />
                                            </StackPanel>
                                        </Expander>
                                        <Expander x:Name="PlanPresentationEditExpander" Header="编辑 PPT 大纲与模板"
                                                  Margin="0,0,0,8" Visibility="Collapsed" IsExpanded="True">
                                            <StackPanel Margin="0,7,0,0">
                                                <TextBlock Text="演示标题" FontSize="10" Foreground="#66806E" />
                                                <TextBox x:Name="PlanPptTitleBox" Margin="0,3,0,6" Padding="7,4" />
                                                <TextBlock Text="保存位置（专属工作区内）" FontSize="10" Foreground="#66806E" />
                                                <TextBox x:Name="PlanPptPathBox" Margin="0,3,0,6" Padding="7,4" />
                                                <TextBlock Text="品牌主题" FontSize="10" Foreground="#66806E" />
                                                <ComboBox x:Name="PlanPptBrandTemplateBox" Margin="0,3,0,6" SelectedIndex="0">
                                                    <ComboBoxItem Content="Codex Grid · 黑白克制" Tag="codex_grid" />
                                                    <ComboBoxItem Content="未名子柔绿 · 温柔清爽" Tag="unnameko_green" />
                                                    <ComboBoxItem Content="夜色代码 · 深色科技" Tag="night_code" />
                                                </ComboBox>
                                                <TextBlock Text="版式策略" FontSize="10" Foreground="#66806E" />
                                                <ComboBox x:Name="PlanPptTemplateBox" Margin="0,3,0,6" SelectedIndex="0">
                                                    <ComboBoxItem Content="自动网格 · 按内容选择双栏/三栏/时间线" Tag="auto_grid" />
                                                    <ComboBoxItem Content="文字简报 · 更适合密集说明" Tag="text_brief" />
                                                    <ComboBoxItem Content="三段汇报 · 强调过程与节奏" Tag="report_flow" />
                                                </ComboBox>
                                                <TextBlock Text="逐页大纲（数字开头为新页，短横线为要点）"
                                                           FontSize="10" Foreground="#66806E" />
                                                <TextBox x:Name="PlanPptOutlineBox" Height="150" Margin="0,3,0,0" Padding="7,5"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                                <TextBlock x:Name="PlanPptVisualSummaryText" Margin="0,5,0,0" FontSize="10"
                                                           Foreground="#66806E" TextWrapping="Wrap" />
                                                <Button Content="保存 PPT 草案修改" Height="27" Margin="0,6,0,0"
                                                        Click="SavePresentationPlanButton_Click" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Text="确认计划只允许开始推进；每个文件写入仍需单独授权。"
                                                   Margin="0,0,0,8" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="#66806E" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="重新生成" Width="72" Height="28" Margin="0,0,8,0"
                                                    Click="RegeneratePlanButton_Click" />
                                            <Button Content="放弃计划" Width="72" Height="28" Margin="0,0,8,0"
                                                    Click="RejectPlanButton_Click" />
                                            <Button Content="确认计划" Width="76" Height="28"
                                                    Click="ConfirmPlanButton_Click"
                                                    Background="#78A98C" Foreground="White" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Expander Header="手动建立单文件任务" Margin="0,12,0,0"
                                          Foreground="{StaticResource InkBrush}">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="任务名称" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                                        <TextBox x:Name="TaskTitleBox" Margin="0,3,0,8" Padding="8,5"
                                                 Text="给主人保存一份笔记" />
                                        <TextBlock Text="文件位置（专属工作区内）" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                                        <TextBox x:Name="TaskPathBox" Margin="0,3,0,8" Padding="8,5"
                                                 Text="notes/new_note.md" />
                                        <TextBlock Text="内容" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                                        <TextBox x:Name="TaskContentBox" Margin="0,3,0,8" Padding="8,6" Height="62"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                        <Button Content="建立任务并请求确认" Height="32" Click="CreateTaskButton_Click"
                                                Background="{StaticResource LeafBrush}" Foreground="White" BorderThickness="0" />
                                    </StackPanel>
                                </Expander>

                                <Expander Header="主人建立的定时提醒" Margin="0,10,0,0"
                                          Foreground="{StaticResource InkBrush}">
                                    <StackPanel Margin="0,7,0,0">
                                        <TextBox x:Name="ReminderTitleBox" Margin="0,0,0,5" Padding="7,4"
                                                 Text="提醒主人休息" />
                                        <TextBox x:Name="ReminderMessageBox" Margin="0,0,0,5" Padding="7,4"
                                                 Text="主人，休息一下、喝点水吧，喵。" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="ReminderDelayBox" Width="62" Padding="7,4" Text="30" />
                                            <TextBlock Text="分钟后" Margin="6,0,8,0" VerticalAlignment="Center" />
                                            <Button Content="建立提醒" Width="78" Click="CreateReminderButton_Click" />
                                            <Button Content="取消选中" Width="78" Margin="6,0,0,0"
                                                    Click="CancelReminderButton_Click" />
                                        </StackPanel>
                                        <ListBox x:Name="ReminderListBox" Height="72" Margin="0,6,0,0"
                                                 DisplayMemberPath="Display" />
                                    </StackPanel>
                                </Expander>

                                <Border x:Name="ApprovalCard" Visibility="Collapsed" Margin="0,12,0,0"
                                        Padding="11" CornerRadius="12" Background="#FFF8E8"
                                        BorderBrush="#E6B96F" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="需要主人的许可" FontWeight="SemiBold" Foreground="#7D5721" />
                                        <TextBlock x:Name="ApprovalSummaryText" Margin="0,5,0,0" TextWrapping="Wrap"
                                                   FontSize="12" Foreground="#5B4A34" />
                                        <TextBlock x:Name="ApprovalScopeText" Margin="0,4,0,8" TextWrapping="Wrap"
                                                   FontSize="10" Foreground="#8A7557" />
                                        <TextBlock x:Name="ApprovalPreviewText" MaxHeight="120" Margin="0,0,0,8"
                                                   TextWrapping="Wrap" FontSize="10" Foreground="#6E604C" />
                                        <Border x:Name="PresentationApprovalPreview" Visibility="Collapsed"
                                                Margin="0,0,0,8" Padding="7" CornerRadius="9"
                                                Background="#FFFDF7" BorderBrush="#D9C69E" BorderThickness="1">
                                            <StackPanel>
                                                <Image x:Name="PresentationPreviewImage" Height="145" Stretch="Uniform"
                                                       SnapsToDevicePixels="True" />
                                                <TextBlock x:Name="PresentationPreviewPageText" Margin="0,5,0,5"
                                                           HorizontalAlignment="Center" FontSize="10" Foreground="#7D6848" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="上一页" Width="58" Height="24" Margin="0,0,5,0"
                                                            Click="PreviousPresentationPreviewButton_Click" />
                                                    <Button Content="下一页" Width="58" Height="24" Margin="0,0,5,0"
                                                            Click="NextPresentationPreviewButton_Click" />
                                                    <Button Content="打开预览目录" Width="88" Height="24"
                                                            Click="OpenPresentationPreviewButton_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="拒绝" Width="62" Height="28" Margin="0,0,8,0"
                                                    Click="RejectApprovalButton_Click" />
                                            <Button Content="允许一次" Width="76" Height="28"
                                                    Click="ApproveApprovalButton_Click"
                                                    Background="#78A98C" Foreground="White" BorderThickness="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="最近任务" Margin="0,13,0,5" FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <ListBox x:Name="TaskListBox" Height="158"
                                         SelectionChanged="TaskListBox_SelectionChanged" FontSize="11"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="2,2,4,4" Padding="9,7" CornerRadius="10"
                                                    Background="#F6FAF7" BorderBrush="#2878A98C" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" Foreground="#3F4B43" />
                                                    <Border Grid.Column="1" Padding="7,2" CornerRadius="8"
                                                            Background="{Binding StatusBrush}" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="#39483E" />
                                                    </Border>
